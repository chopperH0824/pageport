{
  "name": "pageport",
  "version": "0.1.0",
  "description": "A local-first Confluence document publisher for macOS, powered by Mark",
  "author": "PagePort contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js",
    "prepare:mac": "node scripts/prepare-mac.mjs",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "vite": "^6.4.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "me.pageport.desktop",
    "productName": "PagePort",
    "directories": { "output": "release" },
    "files": ["desktop/**", "server/**", "dist/**", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [
      { "from": "resources/mark", "to": "bin/mark" },
      { "from": "resources/mark-LICENSE", "to": "licenses/mark-LICENSE" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "dmg": { "title": "PagePort" }
  }
}
