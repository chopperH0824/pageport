# Exact HTTPS hostnames only. No URLs, wildcards, IPs or paths.
CONFLUENCE_HOSTS=confluence.example.com
# Generate a unique secret of at least 16 characters. Never use a company password.
ACCESS_PASSWORD=replace-with-a-long-random-access-secret
PUBLIC_URL=https://pageport.example.com
# Set only when the service is behind a trusted loopback reverse proxy.
TRUST_PROXY=1
